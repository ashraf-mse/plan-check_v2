{
  "name": "pg-plancheck",
  "version": "0.1.0",
  "description": "Evidence-based PostgreSQL EXPLAIN analysis from your terminal.",
  "type": "module",
  "bin": {
    "plancheck": "./dist/cli.js"
  },
  "files": [
