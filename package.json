{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build -w pg-plancheck-core && next dev",
    "build": "npm run build -w pg-plancheck-core && next build",
    "start": "next start",
    "build:core": "npm run build -w pg-plancheck-core",
    "build:cli": "npm run build -w pg-plancheck-core && npm run build -w pg-plancheck",
    "test:cli": "npm run build:cli && npm test -w pg-plancheck",
    "cli": "npm run build:cli && node packages/cli/dist/cli.js",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "pg-plancheck-core": "0.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lodash": "^4.17.23",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "posthog-js": "^1.341.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.5.6",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ]
}
